# working data cache and logs (raw data is archived in data_archive/)
/data/*
!/data/calendar/
/logs/
# third-party market data (Yahoo Finance) stays on this Mac only; the manifest (row counts,
# time ranges, SHA-256) is committed so results can be tied to the exact data used
/data_archive/*
!/data_archive/.gitkeep
!/data_archive/MANIFEST.csv

